# Local media storage defaults for RustFS from compose.yaml.
VOCAVISTA_S3_ENDPOINT=http://localhost:9000
VOCAVISTA_S3_REGION=us-east-1
VOCAVISTA_S3_BUCKET=vocavista-media
VOCAVISTA_S3_ACCESS_KEY=rustfsadmin
VOCAVISTA_S3_SECRET_KEY=rustfsadmin
VOCAVISTA_S3_PATH_STYLE_ACCESS=true

# Runtime defaults use real ElevenLabs TTS with local RustFS storage and
# browser-side TalkingHead rendering. Automated tests override these values
# from src/test/resources/application.yaml.
VOCAVISTA_MEDIA_PROVIDER_MODE=real
VOCAVISTA_MEDIA_STORAGE_MODE=s3

VOCAVISTA_TTS_PROVIDER=elevenlabs
VOCAVISTA_OPENAI_API_KEY=
VOCAVISTA_ELEVENLABS_API_KEY=
VOCAVISTA_ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
VOCAVISTA_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
VOCAVISTA_ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
VOCAVISTA_ELEVENLABS_FIRST_WORD_SPEED=0.72
VOCAVISTA_ELEVENLABS_SECOND_WORD_SPEED=1.0
VOCAVISTA_ELEVENLABS_PHRASE_SPEED=0.86
