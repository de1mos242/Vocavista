# Local media storage defaults for RustFS from compose.yaml.
VOCAVISTA_S3_ENDPOINT=http://localhost:9000
VOCAVISTA_S3_REGION=us-east-1
VOCAVISTA_S3_BUCKET=vocavista-media
VOCAVISTA_S3_ACCESS_KEY=rustfsadmin
VOCAVISTA_S3_SECRET_KEY=rustfsadmin
VOCAVISTA_S3_PATH_STYLE_ACCESS=true

# Fake providers should remain the default for normal automated tests.
VOCAVISTA_MEDIA_PROVIDER_MODE=fake

# Set provider mode to real and provide the relevant credentials to run opt-in
# integration tests against actual AI provider APIs.
VOCAVISTA_TTS_PROVIDER=openai
VOCAVISTA_LIPSYNC_PROVIDER=did
VOCAVISTA_OPENAI_API_KEY=
VOCAVISTA_ELEVENLABS_API_KEY=
VOCAVISTA_DID_API_KEY=
VOCAVISTA_HEYGEN_API_KEY=
